# Environment and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, coverage, and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/

# Generated application data
data/raw/*
data/processed/*
data/outputs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/outputs/.gitkeep

# Logs and local runtime files
*.log
*.pid
*.sqlite
*.sqlite3

# Jupyter and notebook checkpoints
.ipynb_checkpoints/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Local Docker overrides
docker-compose.override.yml
